{
  "specs": {
    "live": {
      "name": "Gemini Live API",
      "local_file": "live-api-schema.json",
      "experimental": false,
      "description": "Real-time bidirectional audio/video streaming via WebSocket",
      "websocket_endpoints": {
        "google_ai": "wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.{version}.GenerativeService.BidiGenerateContent",
        "google_ai_constrained": "wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContentConstrained",
        "vertex_ai": "wss://{host}/ws/google.cloud.aiplatform.{version}.LlmBidiService/BidiGenerateContent"
      },
      "fetch_mode": "local_file",
      "source_file": "specs/live-api-schema.source.json"
    }
  },
  "output_dir": "/tmp/websocket-googleai-dart",
  "specs_dir": "packages/googleai_dart/specs"
}
